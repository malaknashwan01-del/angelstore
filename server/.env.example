# انسخ هالملف لـ .env (اختياري بالتطوير — كل إشي إله قيمة افتراضية)

# بدون DATABASE_URL السيرفر بيستخدم Postgres مدمج محفوظ بمجلد .data
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# مفتاح توقيع الجلسات — لازم بالنشر، 32 حرف على الأقل
# JWT_SECRET=

# حساب الأدمن اللي بينعمل أول مرة
ADMIN_EMAIL=admin@angelstore.dev
ADMIN_PASSWORD=admin1234

PORT=3001
